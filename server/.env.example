# Copy this file to server/.env on the PCBA host and enter the DeepSeek API key.
# The key is read only by the server; do not put it in web files.
DEEPSEEK_API_KEY=

# Optional: copy each verified local backup to a second disk or LAN share.
# The Windows account running the workbench must have write access.
# Example: PCBA_BACKUP_MIRROR_DIR=E:\PCBA_Backups
# Example: PCBA_BACKUP_MIRROR_DIR=\\fileserver\PCBA_Backups
PCBA_BACKUP_MIRROR_DIR=
